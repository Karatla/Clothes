# 复制为 .env 后使用。install 脚本会自动生成这个文件并填入随机密钥。

# 登录账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=StrongPassword123

# JWT 密钥：必须替换成随机字符串，install 脚本会自动生成
# 手动生成： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_EXPIRES=10h
JWT_REFRESH_EXPIRES=7d

# 允许访问后端的前端地址，多个用逗号分隔
CLIENT_ORIGIN=http://localhost:3000

# 是否自动放行局域网来源（手机、平板用 192.168.x.x 访问时需要）
# 设为 false 则只允许 CLIENT_ORIGIN 里列出的地址
ALLOW_LAN_ORIGINS=true

# Cookie 是否只在 https 下发。用 http 访问时必须是 false，
# 配置好 HTTPS 之后再改成 true。
COOKIE_SECURE=false

# 数据库文件位置。注意必须是 file: 开头，不能写成 sqlite:
DATABASE_URL="file:./dev.db"

# 后端端口
PORT=3001

# HTTPS ports (used when certificates exist, see create-cert)
HTTPS_PORT=3444
WEB_HTTPS_PORT=3443
